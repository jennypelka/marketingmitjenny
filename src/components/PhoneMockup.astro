---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import frame from '../assets/iphone-frame.png';

// Reel inside the iPhone frame: the video sits underneath the transparent screen of the frame image.
interface Props {
  label: string;
  video?: string;
  poster?: ImageMetadata;
  position?: 'left' | 'center' | 'right';
}
const { label, video, poster, position = 'center' } = Astro.props;
---

<figure class:list={['phone', `phone--${position}`]} data-anim="scale-in">
  <div class="phone__screen">
    {video ? (
      <video muted playsinline loop preload="none" poster={poster?.src} aria-label={label} data-lazy-video>
        <source src={video} type="video/mp4" />
      </video>
    ) : (
      <p class="phone__todo">{label}<small>TODO: Video und Poster folgen</small></p>
    )}
  </div>
  <Image class="phone__frame" src={frame} alt="" width={560} height={1149} format="webp" loading="lazy" />
</figure>
