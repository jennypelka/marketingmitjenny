---
interface Props {
  items: { name: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Brotkrumen">
  <ol class="crumbs">
    <li><a href="/">Start</a></li>
    {items.map((item, i) => (
      <li>
        {item.href && i < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </li>
    ))}
  </ol>
</nav>
