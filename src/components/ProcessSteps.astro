---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Step {
  title: string;
  text: string;
  image?: ImageMetadata;
  alt?: string;
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="mj-process" data-anim="stagger" data-progress-line>
  {steps.map((step, i) => (
    <li class="mj-pstep"> <!-- the illustration already shows the step number -->
      {step.image && (
        <Image class="mj-pstep__media" src={step.image} alt={step.alt ?? ''} width={480} height={480} loading="lazy" />
      )}
      <h3 class="mj-pstep__title"><span class="sr-only">{String(i + 1).padStart(2, '0')} </span>{step.title}</h3>
      <p class="mj-pstep__text">{step.text}</p>
    </li>
  ))}
</ol>
