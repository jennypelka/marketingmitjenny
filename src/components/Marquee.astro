---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Endless strip. Items are rendered twice (second set aria-hidden) for the seamless loop.
// Logo items switch to a scrollable strip: it drifts on its own (src/scripts/marquee.ts) and can be swiped,
// dragged, scrolled with the keyboard or moved with the arrow buttons.
type Item = string | { label: string; image: ImageMetadata };
interface Props {
  items: Item[];
  label: string;
}
const { items, label } = Astro.props;
const manual = items.some((item) => typeof item !== 'string');
---

<div class:list={['mj-marquee', { 'mj-marquee--manual': manual }]} role="group" aria-label={label} tabindex={manual ? 0 : undefined} data-anim="marquee">
  <div class="mj-marquee__track">
    {[false, true].map((hidden) =>
      items.map((item) =>
        typeof item === 'string' ? (
          <span class="mj-marquee__item" aria-hidden={hidden || undefined}>{item}</span>
        ) : (
          <span class="marquee-logo" aria-hidden={hidden || undefined}>
            <Image src={item.image} alt={hidden ? '' : item.label} height={96} loading="eager" decoding="async" />
          </span>
        ),
      ),
    )}
  </div>
</div>
{manual && (
  <div class="marquee-nav">
    <button class="icon-btn" type="button" data-marquee-prev aria-label="Vorherige Kunden anzeigen">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
    </button>
    <button class="icon-btn" type="button" data-marquee-next aria-label="Nächste Kunden anzeigen">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
    </button>
  </div>
)}
