---
import { Image } from 'astro:assets';
import logo from '../assets/marketingmitjenny-logo.png';
import { nav } from '../lib/site';

const { path } = Astro.props as { path: string };
---

<header class="mj-nav">
  <div class="mj-nav__bar">
    <a class="mj-nav__logo" href="/" aria-label="marketingmitjenny, Startseite">
      <Image src={logo} alt="" width={124} height={88} loading="eager" />
    </a>
    <nav class="mj-nav__links" id="site-menu" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a class="mj-nav__link" href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <span class="mj-nav__tools">
      <button class="icon-btn" id="theme-btn" type="button" aria-label="Zwischen hellem und dunklem Thema wechseln">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <a class="mj-btn mj-btn--sm" href="/kontakt" aria-current={path === '/kontakt' ? 'page' : undefined}>Kontakt</a>
      <button class="icon-btn icon-btn--menu" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Menü">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </span>
  </div>
</header>
