---
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage: string;
}
const { title, description, path, ogImage } = Astro.props;
// Preview builds (PUBLIC_NOINDEX=true) must never be indexed
const noindex = Astro.props.noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const canonical = path === '/' ? `${site.url}/` : `${site.url}${path}`;
const image = `${site.url}${ogImage}`;
const imageAlt = `${site.name}: ${title}`;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
