---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { leistungen } from '../lib/leistungen';
import { faq } from '../lib/faq';

const channels = ['Instagram', 'TikTok', 'YouTube', 'LinkedIn', 'Facebook'];
---

<BaseLayout page="leistungen">
  <PageIntro crumb="Leistungen" crumbHref="/leistungen" eyebrow="Leistungen" title="Was wir machen">
    <!-- Draft for Jenny's approval: answer-first intro built from existing statements (content/leistungen.md) -->
    <p class="mj-lead" data-anim="rise">
      Wir sind eine Social-Media-Agentur aus Geretsried und machen strategisches Social-Media-Marketing für lokale Unternehmen: von der Strategie über Dreh und Schnitt bis zu Upload, Community Management und monatlichem Reporting. Im kostenfreien Erstgespräch klären wir, ob eine Zusammenarbeit sinnvoll ist.
    </p>
    <div class="mj-row" data-anim="rise">
      <Button href="/kontakt" arrow>Kontakt aufnehmen</Button>
      <Button href="/#ablauf" variant="outline">So läuft die Zusammenarbeit ab</Button>
    </div>
    <ul class="chips" aria-label="Kanäle">
      {channels.map((c) => <li class="chip">{c}</li>)}
    </ul>
  </PageIntro>

  {leistungen.map((l, i) => (
    <Section id={l.id} subtle={i % 2 === 0}>
      <div class="service" data-anim="rise">
        <div class="service__main">
          <span class="service__icon"><Icon name={l.icon} /></span>
          <h2 class="mj-h2">{l.title}</h2>
          <p class="mj-text">{l.text}</p>
          <p class="service__rhythm">{l.rhythm}</p>
        </div>
        <div class="service__card">
          <p class="mj-eyebrow">Das gehört dazu</p>
          <ul class="service__points">
            {l.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </div>
      </div>
    </Section>
  ))}

  <Section id="faq" eyebrow="Häufige Fragen" title="Fragen zur Zusammenarbeit">
    <div class="faq" data-anim="stagger">
      {faq.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="faq__more"><a class="mj-link" href="/referenzen">Das sagen unsere Kunden</a> · <a class="mj-link" href="/ueber-uns">Mehr über Jenny und die Agentur</a></p>
  </Section>

  <CtaBand title="Lassen Sie uns Ihren Auftritt gemeinsam aufbauen." text="Erzählen Sie uns von Ihrem Unternehmen. Im Erstgespräch klären wir Ziele, Zielgruppen und ob die Zusammenarbeit passt." badge="Kostenloses Erstgespräch" />
</BaseLayout>
