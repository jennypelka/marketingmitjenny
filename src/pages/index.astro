---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Tile from '../components/Tile.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import Marquee from '../components/Marquee.astro';
import CtaBand from '../components/CtaBand.astro';
import { leistungen } from '../lib/leistungen';

import hero from '../../content/media/jenny-hero.jpg';
import z1 from '../../content/media/zusammenarbeit-1.png';
import z2 from '../../content/media/zusammenarbeit-2.png';
import z3 from '../../content/media/zusammenarbeit-3.png';
import z4 from '../../content/media/zusammenarbeit-4.png';
import m1 from '../../content/media/referenz-mockup-1.png';
import m2 from '../../content/media/referenz-mockup-2.png';
import m3 from '../../content/media/referenz-mockup-3.png';
import m4 from '../../content/media/referenz-mockup-4.png';
import wornet from '../assets/clients/wornet-ag.png';
import fercak from '../assets/clients/roberto-fercak.png';
import oberhauser from '../assets/clients/oberhauser.png';
import frinopharm from '../assets/clients/frinopharm.png';
import leirich from '../assets/clients/fahrschule-leirich.png';
import kolberbraeu from '../assets/clients/kolberbraeu.png';
import altwirt from '../assets/clients/altwirt-reichersbeuern.png';

// Reels are picked up automatically once content/media/reel-1.mp4 ... reel-4.mp4 exist.
const reelFiles = import.meta.glob('../../content/media/reel-*.mp4', { query: '?url', import: 'default', eager: true }) as Record<string, string>;
const posterFiles = import.meta.glob('../../content/media/reel-*-poster.jpg', { import: 'default', eager: true }) as Record<string, ImageMetadata>;
const reels = [1, 2, 3, 4].map((n) => ({
  n,
  video: reelFiles[`../../content/media/reel-${n}.mp4`],
  poster: posterFiles[`../../content/media/reel-${n}-poster.jpg`],
}));

const steps = [
  { title: 'Kennenlernen', image: z1, text: 'Im kostenfreien Erstgespräch klären wir Bedarf, Ziele, Zielgruppen und den Status Ihres Social-Media Auftritts. Auf dieser Basis entscheiden beide Seiten, ob eine Zusammenarbeit sinnvoll ist. Im anschließenden Onboarding richten wir das technische Setup ein, klären Corporate-Design Richtlinien, Erwartungen und Wünsche und legen die bevorzugten Kommunikationswege fest.' },
  { title: 'Planung', image: z2, text: 'Auf Basis des Onboardings entwickeln wir eine individuelle Social-Media-Strategie als kompaktes Dokument mit Zielen, Kanälen, Formaten, Tonalität, Postingfrequenz und Inhalten der Posts. Direkt danach entsteht der Drehplan mit konkreten Szenen und Hooks, kombiniert aus unseren Vorschlägen und, falls gewünscht, Ihren Ideen. Der Plan bietet einen klaren Überblick und dient als Fahrplan für die Content-Erstellung.' },
  { title: 'Content Produktion', image: z3, text: 'Etwa alle zwei Monate produzieren wir bei Ihnen vor Ort Content mit Fokus auf Kurzvideos und bringen das notwendige Equipment mit. Wir führen den Dreh effizient durch, sichern hochwertiges Material und bereiten alles für Schnitt und Bearbeitung vor. Im Anschluss entstehen CI-konforme Templates, Untertitel, Thumbnails und die finalen Dateien, optimiert für die jeweilige Social-Media-Plattform.' },
  { title: 'Social-Media-Betreuung', image: z4, text: 'Die Freigabe der Inhalte erfolgt wöchentlich per kurzem Meeting oder per Chat. Nach der Freigabe posten wir plattformgerecht und betreuen die Community aktiv. Auf Basis des monatlichen Reportings mit den wichtigsten Kennzahlen erfolgt die Optimierung der Inhalte. Sobald der produzierte Content aufgebraucht ist, startet der nächste Zyklus mit aktualisiertem Drehplan und anschließendem Drehtag.' },
];

// Short facts, rounded down from the numbers in the screenshots (Max: terse style, "Reichweite 180 Tsd.+"). TODO: Kunde je Mockup von Jenny.
const results = [
  { image: m1, alt: 'Instagram Reel-Insights: 316 Profilaktivitäten und 316 neue Follower durch ein einziges Reel, ohne Werbeanzeigen', facts: ['316 neue Follower', 'Durch ein einziges Reel', 'Ohne Ads'] },
  { image: m2, alt: 'Instagram-Beitrag mit 188 Tsd. Aufrufen und 1.305 Likes, ohne Werbeanzeigen', facts: ['Reichweite 180 Tsd.+', '1.300+ Likes', 'Ohne Ads'] },
  { image: m3, alt: 'Instagram-Beitrag mit 210 Tsd. Aufrufen und 720 Likes, ohne Werbeanzeigen', facts: ['Reichweite 200 Tsd.+', '700+ Likes', 'Ohne Ads'] },
  { image: m4, alt: 'Instagram-Beitrag mit 185 Tsd. Aufrufen und 1.001 Likes, ohne Werbeanzeigen', facts: ['Reichweite 180 Tsd.+', '1.000+ Likes', 'Ohne Ads'] },
];

// The ten benefits of the old word cloud, same order, split into three bands (content/startseite.md, section 6)
const benefitBands = [
  { id: 'a', items: ['Mehr Kundenanfragen', 'Höhere Sichtbarkeit', 'Stärkeres Image'] },
  { id: 'b', items: ['Mehr Vertrauen', 'Messbare Ergebnisse', 'Engere Kundenbindung'] },
  { id: 'c', items: ['Vorsprung vor Wettbewerbern', 'Einfacheres Recruiting', 'Potenzial für virale Posts', 'Zukunftssicherheit'] },
];

// TODO: Nutzungsfreigabe der Kundenlogos durch die Kunden bestätigen (Jenny)
const clients = [
  { label: 'WorNet AG', image: wornet },
  { label: 'Roberto Fercak', image: fercak },
  { label: 'Oberhauser', image: oberhauser },
  { label: 'Frinopharm', image: frinopharm },
  { label: 'Fahrschule Leirich', image: leirich },
  // Kolberbräu links to its own site; Altwirt Reichersbeuern is deliberately not linked (site currently hacked, Jenny 25.10.2026)
  { label: 'Posthotel Kolberbräu', image: kolberbraeu, href: 'https://www.kolberbraeu.de/' },
  { label: 'Landgasthaus zum Altwirt Reichersbeuern', image: altwirt },
];
---

<BaseLayout page="home">
  <section class="mj-hero mj-section" data-anim="parallax-soft">
    <div class="mj-wrap mj-hero__grid">
      <div class="mj-stack">
        <h1 class="mj-display-xl" data-anim="mask-reveal">
          <span class="mask-line"><span><span class="mj-hl">Einzigartiger</span> Social-Media-Auftritt für Ihr Unternehmen</span></span>
        </h1>
        <p class="mj-lead" data-anim="rise">Wir machen strategisches Social-Media-Marketing für lokale Unternehmen</p>
        <div class="mj-row" data-anim="rise">
          <Button href="/kontakt" size="lg" arrow>Kontakt aufnehmen</Button>
        </div>
      </div>
      <div class="mj-hero__media" data-anim="parallax-soft" data-parallax="self">
        <Image src={hero} alt="Jennifer Pelka lächelt in die Kamera, die Arme verschränkt" width={640} height={800} widths={[480, 640, 960]} sizes="(max-width: 991px) 100vw, 40vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <Section id="leistungen" eyebrow="Leistungen" title="Was wir machen">
    <BentoGrid>
      {leistungen.map((l) => <Tile title={l.title} icon={l.icon} tone={l.tone} span={l.span}>{l.text}</Tile>)}
    </BentoGrid>
    <p class="section-more"><a class="mj-link" href="/leistungen">Alle Leistungen im Detail</a></p>
  </Section>

  <Section id="ablauf" eyebrow="Zusammenarbeit" title="Wie die Zusammenarbeit abläuft" subtle>
    <ProcessSteps steps={steps} />
  </Section>

  <Section id="referenzen" eyebrow="Referenzen" title="Was wir bisher erreicht haben">
    <ul class="results" data-anim="stagger" role="list" aria-label="Ergebnisse als Mockups" tabindex="0">
      {results.map((r) => (
        <li class="result-item">
          <div class="result"><Image src={r.image} alt={r.alt} width={800} height={800} widths={[400, 800]} sizes="(max-width: 991px) 80vw, 280px" loading="lazy" /></div>
          <ul class="result-facts">{r.facts.map((f) => <li>{f}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="section-more"><a class="mj-link" href="/referenzen">Alle Referenzen ansehen</a></p>
  </Section>

  <Section id="reels" eyebrow="Reels" title="Was wir bereits umgesetzt haben" subtle>
    <div class="reels-wrap" data-reels data-anim="rise">
      <div class="reels" role="group" aria-roledescription="Karussell" aria-label="Reels unserer Kunden">
        {reels.map((r, i) => (
          <div class="reel-slide" data-reel-slide role="group" aria-roledescription="Folie" aria-label={`Reel ${r.n} von ${reels.length}`}>
            <PhoneMockup label={`Reel ${r.n}`} video={r.video} poster={r.poster} position="center" carousel />
          </div>
        ))}
      </div>
      <div class="reels-nav">
        <button class="icon-btn" type="button" data-reels-prev aria-label="Vorheriges Reel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <div class="reels-dots">
          {reels.map((r) => (
            <button class="reels-dot" type="button" data-reels-dot aria-label={`Reel ${r.n} von ${reels.length} anzeigen`}><span></span></button>
          ))}
        </div>
        <button class="icon-btn" type="button" data-reels-next aria-label="Nächstes Reel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-reels-status></p>
    </div>
  </Section>

  <section class="mj-section benefits-band" id="nutzen" data-theme="dark" aria-labelledby="nutzen-title">
    <div class="mj-wrap">
      <div class="mj-head" data-anim="rise">
        <p class="mj-eyebrow">Ihr Nutzen</p>
        <h2 class="mj-h2" id="nutzen-title">Warum jedes Unternehmen einen einzigartigen Social-Media-Auftritt haben sollte</h2>
      </div>
    </div>
    <div class="benefit-bands">
      {benefitBands.map((band) => (
        <div class={`benefit-band benefit-band--${band.id}`}>
          <ul class="benefit-track">
            {[false, true].map((hidden) =>
              band.items.map((text) => <li aria-hidden={hidden || undefined}>{text}</li>),
            )}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <Section id="kunden" eyebrow="Kunden" title="Wem wir bereits helfen konnten" subtle>
    <Marquee label="Unsere Kunden" items={clients} />
  </Section>

  <CtaBand
    badge="Kostenloses Erstgespräch"
    title="Lassen Sie uns Ihren Auftritt gemeinsam aufbauen."
    text="Erzählen Sie uns von Ihrem Unternehmen. Im Erstgespräch klären wir Ziele, Zielgruppen und ob die Zusammenarbeit passt."
  />
</BaseLayout>
